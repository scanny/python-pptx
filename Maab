except FileNotFoundError:
    pass

title_box = slide3.shapes.add_textbox(Inches(2), Inches(1), Inches(8), Inches(1))
title_frame = title_box.text_frame
title_frame.text = "الأهداف"
p = title_frame.paragraphs[0]
p.font.size = title_font_size
p.font.bold = True
p.font.color.rgb = blue_dark

content_box = slide3.shapes.add_textbox(Inches(1.5), Inches(2.5), Inches(8), Inches(3))
content_frame = content_box.text_frame
content_frame.text = (
    "🔹 توضيح الفكرة العامة للعرض.\n"
