p.alignment = PP_ALIGN.CENTER

# حفظ الملف
prs.save("عرض_تقديمي_احترافي_بتصميم.pptx")

print("✅ تم إنشاء العرض وحفظه باسم 'عرض_تقديمي_احترافي_بتصميم.pptx'")
