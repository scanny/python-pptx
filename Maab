slide2 = prs.slides.add_slide(prs.slide_layouts[6])
set_gradient_background(slide2, blue_light, gray_light)

icon_x = Inches(0.5)
icon_y = Inches(0.7)
try:
    slide2.shapes.add_picture("icon_intro.png", icon_x, icon_y, Inches(1), Inches(1))
except FileNotFoundError:
    pass

title_box = slide2.shapes.add_textbox(Inches(2), Inches(1), Inches(8), Inches(1))
title_frame = title_box.text_frame
title_frame.text = "المقدمة"
p = title_frame.paragraphs[0]
p.font.size = title_font_size
p.font.bold = True
p.font.color.rgb = blue_dark

content_box = slide2.shapes.add_textbox(Inches(1.2), Inches(2.5), Inches(8), Inches(3))
content_frame = content_box.text_frame
content_frame.text = (
    "يتناول هذا العرض مقدمة شاملة عن الموضوع.\n"
    "سنتعرّف على أهداف العرض والمحتوى الرئيسي بطريقة بسيطة وواضحة."
)
p = content_frame.paragraphs[0]
p.font.size = content_font_size
p.font.color.rgb = RGBColor(44, 62, 80)

# -------------------------------
# 3️⃣ شريحة الأهداف
# -------------------------------
slide3 = prs.slides.add_slide(prs.slide_layouts[6])
set_gradient_background(slide3, blue_light, white)

try:
