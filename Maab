for p in content_frame.paragraphs:
    p.font.size = content_font_size
    p.font.color.rgb = RGBColor(44, 62, 80)

# -------------------------------
# 4️⃣ شريحة المحتوى
# -------------------------------
slide4 = prs.slides.add_slide(prs.slide_layouts[6])
set_gradient_background(slide4, gray_light, white)

try:
    slide4.shapes.add_picture("icon_content.png", Inches(0.5), Inches(0.5), Inches(1), Inches(1))
