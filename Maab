from pptx import Presentation
from pptx.util import Inches, Pt
from pptx.dml.color import RGBColor
from pptx.enum.text import PP_ALIGN

# إنشاء عرض تقديمي جديد
prs = Presentation()

# دالة مساعدة لإضافة خلفية متدرجة (محاكاة بسيطة)
def set_gradient_background(slide, color1, color2):
    # python-pptx لا يدعم gradient حقيقي، لذا نستخدم مستطيل يغطي الشريحة
    shape = slide.shapes.add_shape(
        1, Inches(0), Inches(0), prs.slide_width, prs.slide_height
    )
    fill = shape.fill
    fill.solid()
    fill.fore_color.rgb = color1
    shape.line.fill.background()
    # اللون الثاني يُستخدم لتظليل النصوص أو العناوين لجعلها متناسقة

# إعداد الألوان
blue_dark = RGBColor(41, 128, 185)
blue_light = RGBColor(52, 152, 219)
gray_light = RGBColor(236, 240, 241)
white = RGBColor(255, 255, 255)

# إعداد الخط العام
title_font_size = Pt(40)
content_font_size = Pt(20)

# -------------------------------
# 1️⃣ شريحة العنوان
# -------------------------------
slide1 = prs.slides.add_slide(prs.slide_layouts[6])
set_gradient_background(slide1, blue_dark, blue_light)

title_box = slide1.shapes.add_textbox(Inches(1), Inches(2.5), Inches(8), Inches(1.5))
frame = title_box.text_frame
frame.text = "العرض التقديمي الاحترافي"
p = frame.paragraphs[0]
p.font.size = title_font_size
p.font.bold = True
p.font.color.rgb = white
p.alignment = PP_ALIGN.CENTER

subtitle_box = slide1.shapes.add_textbox(Inches(1), Inches(4), Inches(8), Inches(1))
sub_frame = subtitle_box.text_frame
sub_frame.text = "من إعداد: فريق العمل"
sub = sub_frame.paragraphs[0]
sub.font.size = Pt(24)
sub.font.color.rgb = white
sub.alignment = PP_ALIGN.CENTER

try:
    slide1.shapes.add_picture("icon_presentation.png", Inches(0.5), Inches(0.5), Inches(1.2), Inches(1.2))
except FileNotFoundError:
    pass

# -------------------------------
# 2️⃣ شريحة المقدمة
